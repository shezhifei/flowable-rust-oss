    <startEvent id="start" />
    <sequenceFlow id="f1" sourceRef="start" targetRef="fork" />
    <parallelGateway id="fork" />
    <sequenceFlow id="f2" sourceRef="fork" targetRef="assignedTask" />
    <sequenceFlow id="f3" sourceRef="fork" targetRef="openTask" />
