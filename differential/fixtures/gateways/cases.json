        {
          "op": "start",
          "variables": { "takeA": true, "takeB": true }
        },
        { "op": "signalEvent", "signalName": "cancelSignal" },
        { "op": "completeTask", "taskDefinitionKey": "taskB" },
        { "op": "snapshot" }
      ]
