      "operations": [
        { "op": "deploy", "bpmn": "inclusive_join_terminate.bpmn20.xml" },
        {
          "op": "start",
          "variables": { "takeSub": true, "takeB": true }
        },
        { "op": "completeTask", "taskDefinitionKey": "preTerminate" },
        { "op": "completeTask", "taskDefinitionKey": "taskB" },
        { "op": "snapshot" }
      ]
    },
