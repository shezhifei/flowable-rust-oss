    {
      "java_api": "CmmnDeploymentBuilder.addInputStream(String, InputStream)",
      "rust_api": "CmmnDeploymentBuilder::add_bytes(name, bytes)",
      "category": "deployment_builder",
      "status": "intentionally_different",
      "tests": ["deployment_builder_accepts_raw_cmmn_and_attachments"],
      "rationale": "Rust uses bytes slices instead of Java InputStream; add_bytes covers the same functional capability. InputStream is a Java I/O abstraction not idiomatic in Rust."
    },
